# Absolute origin, used for canonical URLs, OG tags, and sitemaps.
NEXT_PUBLIC_SITE_URL=https://concepts.example.com

# Gates the internal gallery at "/". Concepts stay public.
# Unset locks the gallery rather than opening it.
GALLERY_PASSWORD=

# Only needed to regenerate concept imagery with assets/*/tooling/gen.mjs.
GEMINI_API_KEY=

# Cuvette's product source. Both set: the live Shopify Storefront API. Either empty: the local mock store
# (app/(concepts)/cuvette/_lib/shopify/mock-store.json). Domain is the shop's xxx.myshopify.com.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Signs Shopify's product webhooks to /cuvette/api/shopify/revalidate.
SHOPIFY_WEBHOOK_SECRET=
