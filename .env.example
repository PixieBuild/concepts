# Absolute origin, used for canonical URLs, OG tags, and sitemaps.
NEXT_PUBLIC_SITE_URL=https://concepts.example.com

# Gates the internal gallery at "/". Concepts stay public.
# Unset locks the gallery rather than opening it.
GALLERY_PASSWORD=

# Only needed to regenerate concept imagery with assets/*/tooling/gen.mjs.
GEMINI_API_KEY=
